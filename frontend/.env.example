# Public Google Web OAuth client ID used by Google Identity Services.
# This is intentionally public and must match backend/.env GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Supabase Auth and Edge Function configuration for the future API cutover.
# Use the project's publishable/anon key only in the browser, never a service key.
VITE_SUPABASE_URL=https://avlbsficfejvwokxkgyl.supabase.co
VITE_SUPABASE_ANON_KEY=

# PostHog product analytics (Frontend → PostHog project settings → Project API key).
# Both values are public build-time values; never put a personal API key here.
# Capturing stays off until a member opts in under Settings → Trust & privacy.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
