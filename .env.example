# ============================================================
# WASSAA — environment reference (project root)
# ============================================================
#
# Legacy Express fallback configuration. Its template lives next to the code:
#
#   backend/.env.example   ->  copy to backend/.env and fill in
#
#   PORT, NODE_ENV, CORS_ORIGINS, SESSION_JWT_SECRET, DATA_BACKEND,
#   SUPABASE_DB_URL, TERMII_* / TWILIO_*, PAYSTACK_*, ADMIN_API_KEY
#
# The current frontend calls Supabase Edge Functions directly; set
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, and VITE_GOOGLE_CLIENT_ID in
# frontend/.env. API_TARGET only affects the legacy Express rollback server.
API_TARGET=http://localhost:8787

# Supabase Edge migration is staged. These browser values are public; the
# service role key, Termii key, and hook secret belong in Supabase secrets.
# VITE_SUPABASE_URL=https://avlbsficfejvwokxkgyl.supabase.co
# VITE_SUPABASE_ANON_KEY=
