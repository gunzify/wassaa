import express, { Request, Response, NextFunction } from 'express';
import path from 'path';
import { fileURLToPath } from 'url';
import fs from 'fs';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = Number(process.env.PORT) || 3000;

// Security & Parsing Middleware
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));

// Custom Security Headers (Anti-Data Leaks & Protection)
app.use((req: Request, res: Response, next: NextFunction) => {
  res.setHeader('X-Content-Type-Options', 'nosniff');
  res.setHeader('X-Frame-Options', 'SAMEORIGIN');
  res.setHeader('X-XSS-Protection', '1; mode=block');
  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
  res.setHeader('Permissions-Policy', 'camera=*, microphone=*');
  next();
});

// --- IN-MEMORY DATABASE & BACKEND STATE ---

interface StoredUser {
  id: string;
  phone: string;
  name: string;
  age: number;
  gender: 'female' | 'male';
  professionCategory: string;
  professionTitle: string;
  service?: string;
  rank?: string;
  dutyStation?: string;
  city: string;
  state: string;
  distanceKm: number;
  bio: string;
  photos: string[];
  interests: string[];
  intentions: string[];
  verification: {
    status: 'verified' | 'pending' | 'not_started';
    verifiedAt?: string;
    hasGovernmentId: boolean;
    hasLiveSelfie: boolean;
    documentType?: string;
    cryptographicBadgeId?: string;
  };
  privacy: {
    serviceVisibility: 'public' | 'matches' | 'private';
    rankVisibility: 'public' | 'matches' | 'private';
    verificationDisplay: 'badge' | 'service_badge' | 'minimal';
    chatNotifications: boolean;
    twoFactorAuth: boolean;
    privateIntroductionOptIn: boolean;
  };
  tier: 'free' | 'premium' | 'hyper_premium';
  likesGiven: string[]; // user IDs this user liked
  passesGiven: string[];
}

interface StoredMessage {
  id: string;
  conversationId: string;
  senderId: string;
  text?: string;
  timestamp: string;
  voiceNote?: {
    durationSeconds: number;
    durationLabel: string;
    audioWaveform: number[];
  };
  mediaUrl?: string;
  caption?: string;
}

