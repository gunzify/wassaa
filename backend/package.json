{
  "name": "wassaa-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
