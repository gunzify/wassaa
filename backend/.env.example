# ============================================================
# WASSAA Backend - environment configuration
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ============================================================

# --- Core ---
PORT=8787
NODE_ENV=development

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Supabase Edge API CORS allowlist. Use only deployed app origins in production.
APP_ORIGINS=https://wassaa.app

# Session signing secret (generate: openssl rand -hex 32)
SESSION_JWT_SECRET=change-me-to-a-64-char-random-hex

# Google Identity Services Web OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# --- Data layer ---
# memory  = zero-setup dev/preview store seeded with demo profiles
# supabase = production Postgres via Supabase connection string
DATA_BACKEND=memory

# From Supabase Dashboard -> Project Settings -> Database
# Prefer the Supavisor pooler: newer projects resolve db.<ref>.supabase.co to
# IPv6 only, so the direct host fails on IPv4-only networks.
#   session mode  (long-lived server): 5432
#   transaction mode (serverless):     6543
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Do not append ?sslmode=require: pg negotiates TLS in src/store/pg.ts.
# After filling this in:  npm run db:migrate   (and optionally: npm run db:seed)
SUPABASE_DB_URL=

# --- SMS / OTP delivery ---
# Termii (Nigerian-friendly, https://termii.com) - recommended
TERMII_API_KEY=
TERMII_SENDER_ID=WASSAA
TERMII_BASE_URL=https://api.ng.termii.com
# Set this to the same v1,whsec_<base64> value configured in Supabase Auth > Hooks > Send SMS.
SEND_SMS_HOOK_SECRET=
# Twilio alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments (Paystack, https://dashboard.paystack.com) ---
PAYSTACK_SECRET_KEY=
# Comma-separatedlisted callback URLs appended for checkout
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/callback

# --- Object storage (Cloudflare R2) ---
# Keep verification media in a private bucket and profile photos in a separate
# public bucket. The same account API token can be scoped to both buckets.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=wassaa
R2_PRIVATE_BUCKET=wassaa
R2_PUBLIC_BUCKET=wassaa-public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- Admin / manual verification review panel ---
# Any long random string; sent by admin tools as `x-admin-key` header
ADMIN_API_KEY=
